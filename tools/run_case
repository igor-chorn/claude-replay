#!/usr/bin/env python3
"""Record one case: start mitmdump, run the steps with claude -p, write a manifest.

    uv run tools/run_case --case A1 "Say hello."
    uv run tools/run_case --case A1-A2 "Say hello." "Explain the Sieve of Eratosthenes."

Every prompt is one step. Step 1 is a fresh session; later steps resume it.
Leaves logs/<run-id>/ with:
    manifest.json  flows.mitm  streams/  mitmdump.log
    steps/NN/stdout.jsonl  steps/NN/stderr.txt

claude runs in an empty directory <scratch-root>/<run-id>. Claude Code loads
CLAUDE.md from every ancestor of its working directory, so that directory must
not live under this repository (or any other tree with instruction files).
"""

import argparse
import datetime
import json
import os
import shutil
import signal
import socket
import subprocess
import sys
import tempfile
import time
from pathlib import Path

from mitmproxy import http
from mitmproxy import io as mitm_io

TOOLS = Path(__file__).resolve().parent
REPO = TOOLS.parent
SYSTEM_PATH = "/usr/local/bin:/usr/bin:/bin"


def utc_now() -> str:
    return datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="milliseconds")


def port_accepts(port: int) -> bool:
    with socket.socket() as s:
        s.settimeout(0.5)
        return s.connect_ex(("127.0.0.1", port)) == 0


def first_line(argv: list[str], env: dict) -> str:
    out = subprocess.run(argv, env=env, capture_output=True, text=True, timeout=60)
    text = (out.stdout or out.stderr).strip()
    return text.splitlines()[0] if text else ""


def find_session_id(stdout_path: Path) -> str | None:
    for line in stdout_path.read_text(errors="replace").splitlines():
        try:
            event = json.loads(line)
        except ValueError:
            continue
        if isinstance(event, dict) and event.get("session_id"):
            return event["session_id"]
    return None


def context_files_above(path: Path) -> list[str]:
    """Instruction files Claude Code would pick up from path or its ancestors."""
    user_level = Path.home() / ".claude"
    found = []
    for d in (path, *path.parents):
        for name in ("CLAUDE.md", "CLAUDE.local.md", ".claude"):
            if (d / name).exists() and d / name != user_level:
                found.append(str(d / name))
    return found


def detect_auth(flows_path: Path) -> tuple[str, list[str]]:
    """Auth kind from the names of the auth headers on /v1/messages requests."""
    names: set[str] = set()
    if flows_path.exists():
        with open(flows_path, "rb") as f:
            for flow in mitm_io.FlowReader(f).stream():
                if not isinstance(flow, http.HTTPFlow):
                    continue
                if not flow.request.path.startswith("/v1/messages"):
                    continue
                for name in ("x-api-key", "authorization"):
                    if name in flow.request.headers:
                        names.add(name)
    kind = {("x-api-key",): "api_key", ("authorization",): "oauth"}.get(
        tuple(sorted(names)), "unknown"
    )
    return kind, sorted(names)


def stop_mitmdump(proc: subprocess.Popen) -> int:
    if proc.poll() is None:
        proc.send_signal(signal.SIGINT)
        try:
            proc.wait(timeout=20)
        except subprocess.TimeoutExpired:
            proc.terminate()
            try:
                proc.wait(timeout=10)
            except subprocess.TimeoutExpired:
                proc.kill()
                proc.wait()
    return proc.returncode


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("prompts", nargs="+", metavar="PROMPT", help="one prompt per step")
    ap.add_argument("--case", default="case", help="case label used in the run id")
    ap.add_argument("--model", help="passed to claude as --model")
    ap.add_argument("--port", type=int, default=8080)
    ap.add_argument("--logs-dir", type=Path, default=REPO / "logs")
    ap.add_argument("--scratch-root", type=Path, default=Path(tempfile.gettempdir()) / "claude-replay-scratch",
                    help="parent of the per-run working directory of claude")
    ap.add_argument("--confdir", type=Path, default=Path.home() / ".mitmproxy", help="mitmproxy confdir (CA)")
    ap.add_argument("--claude-bin", default=shutil.which("claude"))
    ap.add_argument("--mitmdump-bin", default=shutil.which("mitmdump"))
    ap.add_argument("--pass-env", action="append", default=[], metavar="NAME",
                    help="extra variable to copy into the claude environment (repeatable)")
    ap.add_argument("--step-timeout", type=float, default=900.0, help="seconds per step")
    args = ap.parse_args()

    if not args.claude_bin or not args.mitmdump_bin:
        print("run_case: claude or mitmdump not found (run via `uv run`)", file=sys.stderr)
        return 2
    claude = str(Path(args.claude_bin).resolve())
    if port_accepts(args.port):
        print(f"run_case: port {args.port} is already in use", file=sys.stderr)
        return 2

    run_id = datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%dT%H%M%SZ") + "-" + args.case
    run_dir = (args.logs_dir / run_id).resolve()
    scratch = (args.scratch_root / run_id).resolve()
    leaks = context_files_above(scratch)
    if leaks:
        print(f"run_case: {scratch} would inherit instruction files: {', '.join(leaks)}", file=sys.stderr)
        return 2
    streams = run_dir / "streams"
    for d in (scratch, streams, run_dir / "steps"):
        d.mkdir(parents=True, exist_ok=False)
    flows_path = run_dir / "flows.mitm"
    ca = args.confdir / "mitmproxy-ca-cert.pem"

    child_env = {
        "HOME": str(Path.home()),
        "PATH": f"{Path(args.claude_bin).parent}:{SYSTEM_PATH}",
    }
    for name in args.pass_env:
        if name not in os.environ:
            print(f"run_case: --pass-env {name}: not set", file=sys.stderr)
            return 2
        child_env[name] = os.environ[name]

    mitmdump_argv = [
        args.mitmdump_bin,
        "--listen-host", "127.0.0.1",
        "--listen-port", str(args.port),
        "--set", f"confdir={args.confdir}",
        "-w", str(flows_path),
        "-s", str(TOOLS / "tee_sse.py"),
        "--set", f"tee_dir={streams}",
    ]
    manifest = {
        "run_id": run_id,
        "case": args.case,
        "claude_code_version": first_line([claude, "--version"], child_env),
        "mitmproxy_version": first_line([args.mitmdump_bin, "--version"], dict(os.environ)),
        "model": args.model,
        "proxy_port": args.port,
        "scratch_dir": str(scratch),
        "mitmdump_argv": mitmdump_argv,
        # PWD and SHLVL are not passed by us: bash adds them when it runs viamitm
        "claude_env_names": sorted([*child_env, "HTTPS_PROXY", "NODE_EXTRA_CA_CERTS", "PWD", "SHLVL"]),
        "started_at": utc_now(),
        "steps": [],
    }

    log = open(run_dir / "mitmdump.log", "wb")
    proxy = subprocess.Popen(mitmdump_argv, stdin=subprocess.DEVNULL, stdout=log, stderr=subprocess.STDOUT)
    failed = None
    try:
        deadline = time.monotonic() + 30
        while not port_accepts(args.port):
            if proxy.poll() is not None:
                raise RuntimeError(f"mitmdump exited with {proxy.returncode}, see {run_dir}/mitmdump.log")
            if time.monotonic() > deadline:
                raise RuntimeError("mitmdump did not start listening within 30 s")
            time.sleep(0.1)

        session_id = None
        for n, prompt in enumerate(args.prompts, start=1):
            flags = ["--output-format", "stream-json", "--verbose"]
            if args.model:
                flags += ["--model", args.model]
            if n > 1:
                if not session_id:
                    raise RuntimeError("no session_id in the output of step 1, cannot resume")
                flags += ["--resume", session_id]
            argv = [str(TOOLS / "viamitm"), "-p", str(args.port), "-c", str(ca), "--",
                    claude, "-p", prompt, *flags]
            step_dir = run_dir / "steps" / f"{n:02d}"
            step_dir.mkdir()
            step = {"n": n, "prompt": prompt, "argv": argv, "started_at": utc_now()}
            manifest["steps"].append(step)
            with open(step_dir / "stdout.jsonl", "wb") as out, open(step_dir / "stderr.txt", "wb") as err:
                try:
                    done = subprocess.run(argv, cwd=scratch, env=child_env, stdin=subprocess.DEVNULL,
                                          stdout=out, stderr=err, timeout=args.step_timeout)
                    step["exit_code"] = done.returncode
                except subprocess.TimeoutExpired:
                    step["exit_code"] = None
                    step["timed_out"] = True
            step["ended_at"] = utc_now()
            if n == 1:
                session_id = find_session_id(step_dir / "stdout.jsonl")
                manifest["session_id"] = session_id
            if step["exit_code"] != 0:
                failed = f"step {n} exit code {step['exit_code']}"
                break
        # let mitmproxy finish flows that were cut off when claude exited
        time.sleep(1.0)
    except (RuntimeError, KeyboardInterrupt) as e:
        failed = str(e) or type(e).__name__
    finally:
        manifest["mitmdump_exit_code"] = stop_mitmdump(proxy)
        log.close()
        manifest["ended_at"] = utc_now()
        manifest["auth_kind"], manifest["auth_header_names"] = detect_auth(flows_path)
        manifest["error"] = failed
        manifest["scratch_entries_left"] = len(list(scratch.iterdir()))
        if not manifest["scratch_entries_left"]:
            scratch.rmdir()
        (run_dir / "manifest.json").write_text(json.dumps(manifest, indent=2) + "\n")

    print(f"run directory: {run_dir}")
    print("steps: " + ", ".join(f"{s['n']}:exit={s.get('exit_code')}" for s in manifest["steps"]))
    print(f"auth kind: {manifest['auth_kind']}")
    if failed:
        print(f"run_case: FAILED: {failed}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
