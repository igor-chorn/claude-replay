#!/usr/bin/env bash
# Run one command through a local mitmproxy. The proxy variables are set for
# that command only; the calling shell is not touched.
#
#   viamitm [-p PORT] [-c CA_PEM] [--] command [args...]
#
# Defaults: port $MITM_PORT or 8080, CA $MITM_CA or ~/.mitmproxy/mitmproxy-ca-cert.pem
set -euo pipefail

port="${MITM_PORT:-8080}"
ca="${MITM_CA:-$HOME/.mitmproxy/mitmproxy-ca-cert.pem}"

usage() {
    echo "usage: viamitm [-p PORT] [-c CA_PEM] [--] command [args...]" >&2
    exit 2
}

while getopts ":p:c:h" opt; do
    case "$opt" in
        p) port="$OPTARG" ;;
        c) ca="$OPTARG" ;;
        *) usage ;;
    esac
done
shift $((OPTIND - 1))
[ $# -ge 1 ] || usage

[[ "$port" =~ ^[0-9]+$ ]] || { echo "viamitm: bad port: $port" >&2; exit 2; }
[ -r "$ca" ] || { echo "viamitm: CA certificate not readable: $ca" >&2; exit 2; }

exec env \
    HTTPS_PROXY="http://127.0.0.1:$port" \
    NODE_EXTRA_CA_CERTS="$ca" \
    "$@"
